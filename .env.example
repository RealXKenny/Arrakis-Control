# Arrakis Control environment
# Copy this file to .env and replace every placeholder before starting the bot.

# Discord
DISCORD_TOKEN=replace_with_discord_bot_token
CLIENT_ID=replace_with_discord_application_id
DISCORD_CLIENT_SECRET=replace_with_discord_client_secret
GUILD_ID=replace_with_development_guild_id

# Dune Console
DUNE_CONSOLE_URL=http://your-console-host:port
DUNE_CONSOLE_PASSWORD=replace_with_console_password
DUNE_DISCORD_ADAPTER_TOKEN=replace_with_adapter_token

# Optional Advin/Convoy VPS API
ADVIN_API_URL=http:///your-console-host:port
ADVIN_API_KEY=replace_with_advin_api_key

# Discord destinations
DUNE_DISCORD_LINK_PANEL_CHANNEL_ID=replace_with_link_panel_channel_id
DUNE_DISCORD_BLUEPRINT_PANEL_CHANNEL_ID=replace_with_blueprint_panel_channel_id
DUNE_DISCORD_AUDIT_CHANNEL_ID=replace_with_audit_channel_id
LINKED_PLAYER_ROLE_ID=replace_with_linked_player_role_id

# Display and diagnostics
SERVER_NAME=Arrakis Community Server
LOG_LEVEL=INFO

# Dashboard
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8787
DASHBOARD_PUBLIC_URL=http://your-vps-ip:8787

# Optional container override; normally VERSION is used automatically.
# BOT_VERSION=1.0.9
