# Discord application bot token (keep this private)
DISCORD_TOKEN=your_bot_token

# Discord application/client ID
CLIENT_ID=your_application_id

# Optional: deploy commands to one server while developing (updates instantly)
GUILD_ID=your_development_server_id

# Community/server name displayed by bot information commands
SERVER_NAME=Example Server

# Dune Docker Console URL and administrator password.
# The bot logs in at startup and logs out during a clean shutdown.
DUNE_CONSOLE_URL=http://your-console-host:port
DUNE_CONSOLE_PASSWORD=your_console_password

# Discord Adapter (experimental). Enable it in the Dune Docker Console first.
DUNE_DISCORD_ADAPTER_TOKEN=your_discord_adapter_token
DUNE_DISCORD_LINK_PANEL_CHANNEL_ID=your_discord_link_channel
DUNE_DISCORD_BLUEPRINT_PANEL_CHANNEL_ID=your_discord_blueprint_channel
DUNE_DISCORD_AUDIT_CHANNEL_ID=your_discord_audit_channel
LINKED_PLAYER_ROLE_ID=your_linked_player_role_id

# Optional: DEBUG, INFO, WARN, or ERROR (defaults to INFO)
LOG_LEVEL=INFO
