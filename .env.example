# Create a Discord application at https://discord.com/developers/applications
DISCORD_TOKEN=replace-with-your-bot-token
DISCORD_CLIENT_ID=replace-with-your-application-id

# Optional: registers commands to one server immediately while developing.
# Leave blank to register globally (global updates can take up to one hour).
DISCORD_GUILD_ID=

# Prefix commands require the Message Content intent in the Developer Portal.
BOT_PREFIX=!
LOG_LEVEL=info
