{
  "name": "Arrakis-Control-Bot",
  "version": "1.2.0",
  "description": "A modular Discord.js v14 bot.",
  "main": "src/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:dev": "concurrently --kill-others --names bot,dashboard \"node src/index.js\" \"npm run dashboard:dev\"",
    "dashboard": "node src/dashboard/server.js",
    "dev": "node --watch src/index.js",
    "dashboard:dev": "npm --prefix src/dashboard run dev",
    "dashboard:build": "npm --prefix src/dashboard run build",
    "dashboard:start": "npm --prefix src/dashboard run start",
    "dashboard:lint": "npm --prefix src/dashboard run lint",
    "lint": "node src/scripts/check-syntax.js",
    "version:check": "node src/scripts/version.js check",
    "version:sync": "node src/scripts/version.js sync",
    "release:notes": "node src/scripts/version.js notes"
  },
  "dependencies": {
    "canvas": "^3.2.3",
    "concurrently": "^10.0.5",
    "discord.js": "^14.25.1",
    "dotenv": "^17.4.2"
  },
  "allowScripts": {
    "canvas@3.2.3": true
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
