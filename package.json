{
  "name": "arrakis-control",
  "version": "1.1.2",
  "description": "A modular Discord.js v14 bot.",
  "main": "src/index.js",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "lint": "node src/scripts/check-syntax.js",
    "version:check": "node src/scripts/version.js check",
    "version:sync": "node src/scripts/version.js sync",
    "release:notes": "node src/scripts/version.js notes"
  },
  "dependencies": {
    "canvas": "^3.2.3",
    "discord.js": "^14.25.1",
    "dotenv": "^17.4.2"
  },
  "allowScripts": {
    "canvas@3.2.3": true
  }
}
