{
  "name": "arrakis-control",
  "version": "1.0.0",
  "private": true,
  "description": "A modular Discord bot built with Sapphire Framework.",
  "main": "dist/index.js",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/index.js",
    "dev": "tsx watch --env-file=.env src/index.ts",
    "check": "tsc --noEmit",
    "register": "tsx --env-file=.env src/scripts/register-commands.ts"
  },
  "dependencies": {
    "@sapphire/framework": "^5.3.0",
    "discord.js": "^14.25.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
