{
  "name": "arrakis-control",
  "version": "1.0.0",
  "description": "A modular Discord.js v14 bot.",
  "main": "src/index.js",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "deploy:commands": "node src/scripts/deploy-commands.js",
    "lint": "node src/scripts/check-syntax.js",
    "login": "node src/scripts/login.js",
    "version:check": "node src/scripts/check-version.js",
    "version:sync": "node src/scripts/sync-version.js",
    "release:notes": "node src/scripts/generate-release-notes.js"
  },
  "dependencies": {
    "discord.js": "^14.25.1",
    "dotenv": "^16.6.1"
  }
}
